# Local Ollama uses no API key. See README.md and docs/M2_Agent与模型集成.md.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=1024
# Optional cloud mode: LLM_PROVIDER=openai, configure LLM_MODEL and key.
LLM_API_KEY=
# Local embeddings use embeddinggemma:300m in health_agent/rag.py; no key required.
